# Copy this file to .env and fill in your own values.

# Local MongoDB (if you installed MongoDB on your own machine):
MONGODB_URI=mongodb://127.0.0.1:27017

# OR a free MongoDB Atlas cluster (recommended if you don't want to install
# MongoDB locally — sign up at https://www.mongodb.com/cloud/atlas, create a
# free cluster, then copy its connection string here):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/

MONGODB_DB=building_mapper
PORT=3000
